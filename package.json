{
  "name": "hieu-caelestia-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --watch-path=app --watch-path=site.config.mjs scripts/preview.mjs --build",
    "build": "node scripts/build.mjs",
    "start": "node scripts/preview.mjs",
    "test": "npm run build && npm run check && node --test tests/rendered-html.test.mjs",
    "check": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint": "npm run check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}

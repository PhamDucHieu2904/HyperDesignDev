        "paragraphs": [
          {
            "spans": [
              {
                "text": "Nam Viet Group is a leading food and beverage exporter in Vietnam, offering a diverse product portfolio with fruit juices as its flagship line."
              }
            ]
          },
          {
            "spans": [
              {
                "text": "Project: Nam Viet Group Exhibition Booth at THAIFEX 2025 (Thailand) — one of the year's premier food and beverage trade fairs, bringing together distributors, importers, and industry partners nationwide."
              }
            ]
          },
          {
            "spans": [
              {
                "text": "Booth Dimensions: 9m × 6m (54 m²)",
                "bold": true
              }
            ]
          }

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hyperd-admin-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist/admin",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "hyperd-content-staging",
    "database_id": "c201b933-77da-449e-b038-fba2841a659a",
    "migrations_dir": "../../db/migrations"
  }],
  "r2_buckets": [{
    "binding": "MEDIA",
    "bucket_name": "hyperd-media-staging"
  }],
  "vars": {
    "DEPLOY_ENV": "staging",
    "ADMIN_ORIGIN": "https://hyperd-admin-staging.hieu-caelestia-portfolio.workers.dev",
    "ADMIN_EMAIL": "hieuphamdesdev@gmail.com",
    "ACCESS_TEAM_DOMAIN": "hidden-field-ed9a.cloudflareaccess.com",
    "ACCESS_AUD": "d9bf36f75b48430c0babb869d6854ec174b529a146047caa1c3c5e68699e83fc"
  },
  "observability": { "enabled": true }
}
